{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "▶ Run Full ML Pipeline (main.py)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/main.py",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}"
        },
        {
            "name": "▶ Run retail_sales_profitability.py",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/retail_sales_profitability.py",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}"
        },
        {
            "name": "▶ Run Current Python File",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "console": "integratedTerminal",
            "cwd": "${fileDirname}"
        },
